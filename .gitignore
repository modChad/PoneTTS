# Python
__pycache__/
*.pyc
server/venv/

# Downloaded model (~12 GB) and first-run state
server/release/
server/.setup_done
server/tts_server.log
server/.tts_server.pid

# Everything the server writes or you edit (settings, history, caches,
# pronunciations.txt). Seeded from server/defaults/ on first start.
server/data/

# Left over from older versions (moved into server/data/ on first start)
server/state/
server/st_cache/
server/history/
server/sfx_cache/
server/preset.conf
server/pronunciations.txt
server/voice_blend.json
server/voice_fx.json
server/pronunciation_cache.json
server/freesound_key.txt

# Downloaded at first start (see server/apply_voice_patch.py)
server/voice_patch/adapter_model.safetensors
server/voice_patch/*.part

# Generated by run.sh (machine-specific)
docker-compose.yml
docker-compose.yml.bak.*
